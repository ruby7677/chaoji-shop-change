{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaoji-haowan-shop-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./design-preview",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "STORE_NAME": "潮吉好頑",
    "SUPABASE_CUSTOM_PROVIDER": "custom:line-web",
    "LINE_AUTH_ENABLED": "true",
    "LINE_NOTIFY_ENABLED": "true",
    "TELEGRAM_NOTIFY_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "API_ORDER_RATE_LIMITER",
      "namespace_id": "2026091401",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "API_MEMBER_RATE_LIMITER",
      "namespace_id": "2026091402",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "API_ADMIN_RATE_LIMITER",
      "namespace_id": "2026091403",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
